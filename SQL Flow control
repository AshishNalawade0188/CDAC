3) DELIMITER //

DROP PROCEDURE IF EXISTS calculate_factorial //

CREATE PROCEDURE calculate_factorial(IN num INT)
BEGIN
    DECLARE fact BIGINT DEFAULT 1;
    DECLARE i INT DEFAULT 1;
    
    IF num < 0 THEN
        SELECT 'Error: Number must be non-negative' AS Result;
    ELSEIF num = 0 OR num = 1 THEN
        SELECT CONCAT('Factorial of ', num, ' is 1') AS Result;
    ELSE
        WHILE i <= num DO
            SET fact = fact * i;
            SET i = i + 1;
        END WHILE;
        
        SELECT CONCAT('Factorial of ', num, ' is ', fact) AS Result;
    END IF;
END //

DELIMITER ;

