2)  delimiter //
drop procedure if exists update_salary_hike;
create procedure update_salary_hike(in p_job varchar(20))
begin
update emp100
set sal = case
when lower(job) = 'manager'
then sal * 1.05
when lower(job) = 'clerk'
then sal * 1.10
when lower(job) = 'analyst'
then sal*1.07
else sal*1.03
end
where lower(job) = lower(p_job);
end //
delimiter ;

