5) mysql> CREATE PROCEDURE print_range(IN m INT, IN n INT)
    -> BEGIN
    ->     DECLARE start_num INT;
    ->     DECLARE end_num INT;
    ->     DECLARE result_str TEXT DEFAULT '';
    ->
    ->     IF m < n THEN
    ->         SET start_num = m;
    ->         SET end_num = n;
    ->     ELSE
    ->         SET start_num = n;
    ->         SET end_num = m;
    ->     END IF;
    ->
    ->     WHILE start_num <= end_num DO
    ->         IF result_str = '' THEN
    ->             SET result_str = CAST(start_num AS CHAR);
    ->         ELSE
    ->             SET result_str = CONCAT(result_str, ',', start_num);
    ->         END IF;
    ->         SET start_num = start_num + 1;
    ->     END WHILE;
    ->
    ->     SELECT result_str AS output;
    -> END //
