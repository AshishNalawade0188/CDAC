1) delimiter //
drop procedure if exists perfect_no;
create procedure perfect_no(in x int, out y int)
begin
declare i int default 1;
declare sum_val int default 0;

while i < x
do
if(x%i = 0)
then
set sum_val=sum_val+i;
end if;
set i = i+1;
end while;

if x = sum_val 
then
set y = 1;
else
set y = 0;
end if;
end //
delimiter ;


mysql> call perfect_no(6,@a);
    -> //
Query OK, 0 rows affected (0.01 sec)

