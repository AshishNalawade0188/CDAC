3) cqlsh:objtech> create table product( pid int primary key,
           ... name text,
           ... descp text,
           ... price varint,
           ... qty varint);
cqlsh:objtech> insert into product(pid,name,descp,price,qty) values(101,'TV','sony',20000,2);
