5) delimiter //
drop procedure if exists sal_emp;
create procedure sal_emp(n int,out msal decimal(7,2))
begin
declare x int;
declare y decimal(7,2);
select empno,sal into x,y from emp where empno = n;
if x = n 
then set msal = y;
else 
set msal = 0;
end if;
end //
delimiter;


