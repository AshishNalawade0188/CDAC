1) create table product
(
  pid int,
  pname varchar(15),
  price double(7,2),
  qty int
);
insert into product
values(1,'Seema',50000,10),
      (2,'Raj',60500,15),
      (3,'Yash',60000,17);
 select * from product;
+------+-------+----------+------+
| pid  | pname | price    | qty  |
+------+-------+----------+------+
|    1 | Seema | 50000.00 |   10 |
|    2 | Raj   | 60500.00 |   15 |
|    3 | Yash  | 60000.00 |   17 |
+------+-------+----------+------+

create table product_details
(pid int,
amt double(9,2));

delimiter //
create trigger update_amt
after update
on product
for each row
begin
   insert into product_details
   values(old.pid,old.price*old.qty);
end //
delimiter ;

