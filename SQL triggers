3)create table order_master(oid int,pname varchar(20),qty int, price decimal(7,2));
insert into order_master values(1,'ashish',30,50000),(2,'sujita',5,25000),(3,'samiksha',7,20000);
create table order_log(oid int, odate date,amt decimal(9,2));

delimiter //
create trigger insert_order
after insert
on order_master
for each row
begin
   insert into order_log
   values(new.oid,curdate(),new.price*new.qty);
end //
delimiter ;

