create table emp_log(eno int , ename varchar(20),job varchar(20),oldsal double(7,2),newsal double(7,2));

delimiter //
create trigger update_sal_log
AFTER update
on emp_data
for each row
begin
   insert into emp_log(eno,ename,job,oldsal,newsal)
   values(old.eno,old.ename,old.job,old.sal,new.sal);
end //
delimiter ;

