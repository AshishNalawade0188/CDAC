CREATE TABLE Movies (
  movie_id INT PRIMARY KEY,
  title VARCHAR(50),
  genre VARCHAR(30),
  rating DECIMAL(2,1)
);

CREATE TABLE Actors (
  actor_id INT PRIMARY KEY,
  name VARCHAR(50)
);

CREATE TABLE MovieActors (
  movie_id INT,
  actor_id INT,
  constraint PRIMARY KEY (movie_id, actor_id);

