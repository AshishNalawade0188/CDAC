CREATE PROCEDURE find_top_dept1(IN p_deptno INT)
BEGIN
    SELECT 
        d.deptno,
        d.dname,
        d.loc,
        SUM(e.sal) AS "Sum Sal"
    FROM dept d
    JOIN emp e ON d.deptno = e.deptno
    WHERE d.deptno = p_deptno
    GROUP BY d.deptno, d.dname, d.loc;
END $$

DELIMITER ;

