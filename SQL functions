1) delimiter //
CREATE FUNCTION total_sal_comm(sal decimal(7,2),comm decimal(7,2)) returns decimal(7,2)
BEGIN
  set sal=sal+comm;
  return sal;
END //
delimiter ;

 select ename,deptno,sal,comm,total_sal_comm(sal,ifnull(comm,0)) "total_sal_comm" from emp;
