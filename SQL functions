5)  DELIMITER $$

CREATE FUNCTION get_experience(hiredate DATE)
RETURNS INT
DETERMINISTIC
BEGIN
    DECLARE exp INT;
    SET exp = TIMESTAMPDIFF(YEAR, hiredate, CURDATE());
    RETURN exp;
END $$

DELIMITER ;

DELIMITER $$

CREATE PROCEDURE emp_award()
BEGIN
    SELECT 
        ename,
        deptno,
        get_experience(hiredate) AS experience,
        CASE 
            WHEN get_experience(hiredate) > 44 THEN 'Award'
            ELSE NULL
        END AS remark
    FROM emp;
END $$

DELIMITER ;

