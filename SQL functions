DELIMITER $$

CREATE FUNCTION fact(n INT)
RETURNS BIGINT
DETERMINISTIC
BEGIN
    DECLARE i INT DEFAULT 1;
    DECLARE result BIGINT DEFAULT 1;

    WHILE i <= n DO
        SET result = result * i;
        SET i = i + 1;
    END WHILE;

    RETURN result;
END $$

DELIMITER ;



